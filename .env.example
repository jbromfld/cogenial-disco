# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=memora
DB_USER=postgres
DB_PASSWORD=changeme

# ── Embedding ─────────────────────────────────────────────────────────────────
# EMBEDDING_PROVIDER: "local" uses sentence-transformers (no API key needed).
#                     "openai" uses the OpenAI embeddings API.
EMBEDDING_PROVIDER=local

# For "local": a sentence-transformers model name (e.g. all-MiniLM-L6-v2 → 384 dim).
# For "openai": an OpenAI embedding model ID (e.g. text-embedding-3-small → 1536 dim).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# MUST match the model's output dimension AND the VECTOR(N) column in the schema.
# Run `python memory/migrate.py` after changing this — the schema column must be recreated.
# Local MiniLM: 384  |  OpenAI text-embedding-3-small: 1536  |  text-embedding-3-large: 3072
EMBEDDING_DIM=384

# ── Memory tuning ─────────────────────────────────────────────────────────────
# Cosine similarity threshold for matching an existing memory (0.0–1.0).
# Higher = stricter matching (fewer merges, more inserts).
# Tune this when switching embedding models.
MEMORY_SIMILARITY_THRESHOLD=0.80

# ── P-Agent (Orchestrator LLM) ────────────────────────────────────────────────
# Provider: "anthropic" | "openai"
P_AGENT_PROVIDER=anthropic
P_AGENT_MODEL=claude-sonnet-4-6

# ── Q-Agent (Judge LLM) ───────────────────────────────────────────────────────
Q_AGENT_PROVIDER=anthropic
Q_AGENT_MODEL=claude-haiku-4-5-20251001

# ── API Keys ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...  # only needed if using openai provider for agents or embedding

# ── LangSmith Tracing ─────────────────────────────────────────────────────────
# Set LANGCHAIN_TRACING_V2=true to enable. All LLM calls, tool invocations,
# and LangGraph state transitions are traced automatically — no code changes needed.
# IMPORTANT: config must be imported before any langchain_core import in entrypoints.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=memora-cicd

# ── General ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
